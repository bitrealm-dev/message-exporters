import {
    AboutSlint, Button, TabWidget
} from "std-widgets.slint";
import { ContactsPage } from "pages/contacts.slint";
import { ExtractPage } from "pages/extract.slint";
import { FormatPage } from "pages/format.slint";
import { VaultPage } from "pages/vault.slint";
import { LogPage } from "pages/log.slint";

export { ContactsAdapter } from "pages/contacts.slint";
export { ExtractAdapter } from "pages/extract.slint";
export { FormatAdapter } from "pages/format.slint";
export { VaultAdapter } from "pages/vault.slint";
export { LogAdapter } from "pages/log.slint";

export component AppWindow inherits Window {
    // Official Slint small mark (blue S); CC-BY-ND-4.0 from slint-ui/slint logo/.
    icon: @image-url("assets/slint-logo-small-light.png");
    // OS title bar text; version is filled in from Rust (CARGO_PKG_VERSION).
    in-out property <string> app-title: "Message Exporters";
    title: root.app-title;
    preferred-width: 920px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 560px;
    default-font-size: 12px;

    in-out property <int> tab-index: 0;
    in property <string> error-text;
    // Tab that produced the error; -1 means no active error. Banner shows on that tab and Log (4).
    in property <int> error-source-tab: -1;
    in property <string> status-text: "Ready";
    in property <bool> about-open: false;
    in property <bool> tabs-enabled: true;
    property <bool> show-error:
        root.error-text != ""
        && root.error-source-tab >= 0
        && (root.tab-index == root.error-source-tab || root.tab-index == 4);
    callback close-requested();
    callback help-requested();
    callback about-toggled();
    callback error-dismissed();

    // Use Layout (not Box): Box widgets inject StyleMetrics.layout-padding.
    VerticalLayout {
        padding: 0;
        spacing: 0;

        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            alignment: stretch;
            vertical-stretch: 0;
            Image {
                source: @image-url("assets/slint-logo-small-light.png");
                width: 20px;
                height: 20px;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Text {
                text: root.app-title;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: left;
                horizontal-stretch: 1;
            }
            Button {
                text: "Help";
                horizontal-stretch: 0;
                clicked => { root.help-requested(); }
            }
            Button {
                text: "About";
                horizontal-stretch: 0;
                clicked => { root.about-toggled(); }
            }
        }

        if root.show-error: Rectangle {
            background: #fdecea;
            vertical-stretch: 0;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: "Could not continue:\n" + root.error-text;
                    color: #8a1f1f;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Button {
                    text: "Dismiss";
                    horizontal-stretch: 0;
                    clicked => { root.error-dismissed(); }
                }
            }
        }

        if root.about-open: VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: start;
            vertical-stretch: 1;
            Text {
                text: root.app-title + " — Slint desktop GUI";
                font-size: 13px;
                font-weight: 700;
                vertical-stretch: 0;
            }
            Text {
                text: "Desktop GUI for Message Exporters. Same exporters and export.ini as the CLI tools.";
                wrap: word-wrap;
                font-size: 12px;
                vertical-stretch: 0;
            }
            AboutSlint { }
            Button {
                text: "Close";
                horizontal-stretch: 0;
                clicked => { root.about-toggled(); }
            }
        }

        if !root.about-open: TabWidget {
            current-index <=> root.tab-index;
            vertical-stretch: 1;
            Tab {
                title: "Extract Messages";
                ExtractPage { }
            }
            Tab {
                title: "Format";
                FormatPage { }
            }
            Tab {
                title: "Vault";
                VaultPage { }
            }
            Tab {
                title: "Contacts";
                ContactsPage { }
            }
            Tab {
                title: "Log";
                LogPage { }
            }
        }

        Rectangle {
            height: 24px;
            vertical-stretch: 0;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: stretch;
                Text {
                    text: root.status-text;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Slint desktop GUI";
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
        }
    }
}
