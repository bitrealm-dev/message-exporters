import { Button } from "std-widgets.slint";
import {
    LabeledPathField, LabeledComboBox, Hint, ActionRow, PageHeader, PageColumn
} from "../widgets.slint";

export global ContactsAdapter {
    in-out property <string> input;
    // 0 = USA, 1 = International
    in-out property <int> region-index: 0;
    in property <[string]> region-options: ["USA", "International"];
    in property <bool> enabled: true;
    callback browse(string);
    callback check();
    callback update();
}

export component ContactsPage inherits PageColumn {
    PageHeader { title: "Validate contacts"; }

    LabeledPathField {
        label: "Contacts file";
        required: true;
        placeholder: ".vcf or .csv";
        field-id: "contacts.input";
        value <=> ContactsAdapter.input;
        browse-requested(id) => { ContactsAdapter.browse(id); }
    }

    LabeledComboBox {
        label: "Phone format";
        model: ContactsAdapter.region-options;
        current-index <=> ContactsAdapter.region-index;
    }

    Hint {
        message: "Check analyzes the file without writing. Update writes a corrected copy beside the original.";
    }

    // Pin dialog actions to the bottom-right of the tab.
    Rectangle { vertical-stretch: 1; }

    ActionRow {
        Button {
            text: "Check";
            enabled: ContactsAdapter.enabled;
            clicked => { ContactsAdapter.check(); }
        }
        Button {
            text: "Update";
            primary: true;
            enabled: ContactsAdapter.enabled;
            clicked => { ContactsAdapter.update(); }
        }
    }
}
