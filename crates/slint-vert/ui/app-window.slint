import {
    AboutSlint, Button, TabWidget
} from "std-widgets.slint";
import { ContactsPage } from "pages/contacts.slint";
import { ExportPage } from "pages/export.slint";
import { ConvertPage } from "pages/convert.slint";
import { VaultPage } from "pages/vault.slint";
import { LogPage } from "pages/log.slint";

export { ContactsAdapter } from "pages/contacts.slint";
export { ExportAdapter } from "pages/export.slint";
export { ConvertAdapter } from "pages/convert.slint";
export { VaultAdapter } from "pages/vault.slint";
export { LogAdapter } from "pages/log.slint";

export component AppWindow inherits Window {
    title: "Message Exporters — Vertical";
    preferred-width: 640px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 520px;
    default-font-size: 12px;

    in-out property <int> tab-index: 0;
    in property <string> error-text;
    in property <string> status-text: "Ready";
    in property <bool> about-open: false;
    in property <bool> tabs-enabled: true;
    callback close-requested();
    callback about-toggled();

    // Use Layout (not Box): Box widgets inject StyleMetrics.layout-padding.
    VerticalLayout {
        padding: 0;
        spacing: 0;

        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            alignment: stretch;
            vertical-stretch: 0;
            Text {
                text: "Message Exporters — Vertical";
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "About";
                horizontal-stretch: 0;
                clicked => { root.about-toggled(); }
            }
        }

        if root.error-text != "": Rectangle {
            background: #fdecea;
            vertical-stretch: 0;
            HorizontalLayout {
                padding: 8px;
                Text {
                    text: "Could not continue:\n" + root.error-text;
                    color: #8a1f1f;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    font-size: 12px;
                }
            }
        }

        if root.about-open: VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: start;
            vertical-stretch: 1;
            Text {
                text: "Message Exporters — Vertical Slint GUI";
                font-size: 13px;
                font-weight: 700;
                vertical-stretch: 0;
            }
            Text {
                text: "A vertical-form layout experiment. Same exporters, same export.ini.";
                wrap: word-wrap;
                font-size: 12px;
                vertical-stretch: 0;
            }
            AboutSlint { }
            Button {
                text: "Close";
                horizontal-stretch: 0;
                clicked => { root.about-toggled(); }
            }
        }

        if !root.about-open: TabWidget {
            current-index <=> root.tab-index;
            vertical-stretch: 1;
            Tab {
                title: "Extract Messages";
                ExportPage { }
            }
            Tab {
                title: "Format";
                ConvertPage { }
            }
            Tab {
                title: "Vault";
                VaultPage { }
            }
            Tab {
                title: "Contacts";
                ContactsPage { }
            }
            Tab {
                title: "Log";
                LogPage { }
            }
        }

        Rectangle {
            height: 24px;
            vertical-stretch: 0;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: stretch;
                Text {
                    text: root.status-text;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Vertical Slint GUI";
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
        }
    }
}
